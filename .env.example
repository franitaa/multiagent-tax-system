# Copy this file to .env in the project root before using vision extraction.
# Enter your own API keys in .env. Leave unused providers blank.
# Never commit .env or share its contents.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Models used for document extraction.
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_MODEL=claude-sonnet-4-6

# Where the runner writes JSONL traces.
SILVERFILE_TRACE_DIR=traces
