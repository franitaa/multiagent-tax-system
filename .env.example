# Copy to .env (never commit .env). Nothing below is needed to run the offline stubs.
# Only used once an agent calls a real model:
ANTHROPIC_API_KEY=
# Where the runner writes JSONL traces (default: traces)
SILVERFILE_TRACE_DIR=traces

# P3: optional; the local UI also accepts a key without writing a file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_MODEL=claude-sonnet-4-6